# Install as /etc/bloom-relay/gateway.env, mode 0640, no secrets.
BLOOM_RELAY_DATABASE_URL=postgresql:///relay?host=/run/postgresql
BLOOM_RELAY_RESTORE_WITNESS_PATH=/var/lib/bloom-relay/witness/revision
BLOOM_RELAY_GATEWAY_ID=shard-a
# A dedicated public ingress IP preserves Browser source IP for admission quotas.
BLOOM_RELAY_INGRESS_BIND=192.0.2.10:443
BLOOM_RELAY_TUNNEL_BIND=127.0.0.1:18444
BLOOM_RELAY_METRICS_BIND=127.0.0.1:19101
BLOOM_RELAY_HEALTH_BIND=127.0.0.1:19201
