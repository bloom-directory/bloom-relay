BLOOM_RELAY_DATABASE_URL=postgresql:///relay?host=/run/postgresql
BLOOM_RELAY_RESTORE_WITNESS_PATH=/var/lib/bloom-relay/witness/revision
BLOOM_RELAY_PLACEMENT=shard-a
BLOOM_RELAY_DNS_ZONE_ID=ZREPLACEWITHDELEGATEDZONE
BLOOM_RELAY_INGRESS_ADDRESSES=192.0.2.10,2001:db8::10
BLOOM_RELAY_AUTHORITATIVE_ADDRESSES=192.0.2.53
BLOOM_RELAY_METRICS_BIND=127.0.0.1:19103
BLOOM_RELAY_HEALTH_BIND=127.0.0.1:19203
