BLOOM_RELAY_DATABASE_URL=postgresql://bloom-relay-dns-serving@localhost/relay?host=/run/postgresql
BLOOM_RELAY_RESTORE_WITNESS_PATH=/var/lib/bloom-relay/witness/revision
# Off-host witness (production). All three or none.
#BLOOM_RELAY_RESTORE_WITNESS_S3_BUCKET=bloom-relay-relay-1-witness-EXAMPLE
#BLOOM_RELAY_RESTORE_WITNESS_S3_KEY=relay-1/revision
#BLOOM_RELAY_RESTORE_WITNESS_S3_REGION=eu-central-1
BLOOM_RELAY_PLACEMENT=shard-a
BLOOM_RELAY_DNS_PROVIDER=cloudflare
BLOOM_RELAY_DNS_ZONE_ID=REPLACE_WITH_CLOUDFLARE_ZONE_ID
BLOOM_RELAY_INGRESS_ADDRESSES=192.0.2.10
BLOOM_RELAY_AUTHORITATIVE_ADDRESSES=192.0.2.53
BLOOM_RELAY_METRICS_BIND=127.0.0.1:19103
BLOOM_RELAY_HEALTH_BIND=127.0.0.1:19203
