BLOOM_RELAY_DATABASE_URL=postgresql://bloom-relay-ct@localhost/relay?host=/run/postgresql
BLOOM_RELAY_RESTORE_WITNESS_PATH=/var/lib/bloom-relay/witness/revision
# Off-host witness (production). All three or none.
#BLOOM_RELAY_RESTORE_WITNESS_S3_BUCKET=bloom-relay-relay-1-witness-EXAMPLE
#BLOOM_RELAY_RESTORE_WITNESS_S3_KEY=relay-1/revision
#BLOOM_RELAY_RESTORE_WITNESS_S3_REGION=eu-central-1
BLOOM_RELAY_CT_SOURCE=reviewed-log-adapter
BLOOM_RELAY_CT_FEED_ORIGIN=https://ct-feed.internal.example
BLOOM_RELAY_CT_ALERT_URL=https://alerts.internal.example/v1/alerts
BLOOM_RELAY_METRICS_BIND=127.0.0.1:19105
BLOOM_RELAY_HEALTH_BIND=127.0.0.1:19205
