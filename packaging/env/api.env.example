BLOOM_RELAY_DATABASE_URL=postgresql://bloom-relay-api@localhost/relay?host=/run/postgresql
BLOOM_RELAY_RESTORE_WITNESS_PATH=/var/lib/bloom-relay/witness/revision
# Off-host witness (production). All three or none.
#BLOOM_RELAY_RESTORE_WITNESS_S3_BUCKET=bloom-relay-relay-1-witness-EXAMPLE
#BLOOM_RELAY_RESTORE_WITNESS_S3_KEY=relay-1/revision
#BLOOM_RELAY_RESTORE_WITNESS_S3_REGION=eu-central-1
BLOOM_RELAY_CONTROL_BIND=127.0.0.1:18443
# HAProxy sends each client's address with PROXY v2 (send-proxy-v2); every
# connection must carry it. Requires a loopback bind. Use none when clients
# connect to the API directly.
BLOOM_RELAY_CONTROL_PROXY_PROTOCOL=v2
BLOOM_RELAY_CONTROL_AUDIENCE=relay-control.bloom.directory
BLOOM_RELAY_PLACEMENT=shard-a
BLOOM_RELAY_METRICS_BIND=127.0.0.1:19102
BLOOM_RELAY_HEALTH_BIND=127.0.0.1:19202
