BLOOM_RELAY_DATABASE_URL=postgresql://bloom-relay-api@localhost/relay?host=/run/postgresql
BLOOM_RELAY_RESTORE_WITNESS_PATH=/var/lib/bloom-relay/witness/revision
BLOOM_RELAY_CONTROL_BIND=127.0.0.1:18443
BLOOM_RELAY_CONTROL_AUDIENCE=relay-control.bloom.directory
BLOOM_RELAY_PLACEMENT=shard-a
BLOOM_RELAY_METRICS_BIND=127.0.0.1:19102
BLOOM_RELAY_HEALTH_BIND=127.0.0.1:19202
