# Install as /etc/systemd/system/bloom-relay-dns-serving.service.d/cloudflare.conf.
[Service]
EnvironmentFile=
EnvironmentFile=/etc/bloom-relay/dns-serving.cloudflare.env
Environment=
Environment=BLOOM_RELAY_MODE=dns-serving
Environment=BLOOM_RELAY_CLOUDFLARE_TOKEN_FILE=%d/cloudflare
LoadCredential=
LoadCredential=cloudflare:/etc/bloom-relay/cloudflare-serving-token
